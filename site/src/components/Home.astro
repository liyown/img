---
import Icon from './Icon.astro';
import Actions from './Actions.astro';
import Screenshot from './Screenshot.astro';
import Comparison from './Comparison.astro';
import { href, t, type Locale } from '../lib/site';
const { locale } = Astro.props as { locale: Locale };
const steps = t(
  locale,
  [
    [
      '导入图片',
      '拖入文件、粘贴图片或导入图片链接。主窗口会先把图片加入队列，点击上传后才发送。',
      'img upload photo.png --provider r2',
    ],
    [
      '选择存储并上传',
      '选好存储源和处理参数，点击上传。需要的时候，可以暂停、继续和重试。',
      'img upload photo.png --optimize --resize 1600',
    ],
    [
      '复制链接',
      '上传成功后自动复制链接。可选 URL、Markdown 或 HTML，直接粘贴到文章里。',
      'img upload photo.png --format markdown --copy',
    ],
  ],
  [
    [
      'Import images',
      'Drop files, paste an image, or import a URL. In the main window, imports wait until you are ready.',
      'img upload photo.png --provider r2',
    ],
    [
      'Send to your storage',
      'Choose storage and processing options, then upload. Pause, resume, or retry when you need to.',
      'img upload photo.png --optimize --resize 1600',
    ],
    [
      'Copy the links',
      'After uploading, copy links automatically as URLs, Markdown, or HTML and paste them into your document.',
      'img upload photo.png --format markdown --copy',
    ],
  ],
);
const features = t(
  locale,
  [
    [
      'image',
      '图库与历史',
      '网格与列表自由切换，搜索记录，随时找回已上传的图片。',
    ],
    [
      'sliders',
      '上传前处理图片',
      '压缩、缩放、清理 JPEG EXIF。上传前处理，保留原文件。',
    ],
    [
      'command',
      '菜单栏与快捷键',
      '快捷键直接上传剪贴板或截图。macOS 还支持菜单栏操作和关闭窗口后继续上传。',
    ],
    [
      'shield',
      '错误提示与队列恢复',
      '清楚的错误分类，可恢复的队列，两份有效备份。',
    ],
    [
      'copy',
      '选择复制格式',
      '自动复制成功链接，也支持 Markdown、HTML 与 BBCode。',
    ],
    [
      'terminal',
      'AI Agent 集成',
      '提供原生 CLI 与 Agent Skill，支持 JSON 输出、逐文件结果和退出码。复用本地存储配置。',
    ],
  ],
  [
    [
      'image',
      'Library and history',
      'Switch between grids and lists, search records, and find uploaded images again.',
    ],
    [
      'sliders',
      'Process images before upload',
      'Compress, resize, and remove JPEG EXIF before upload. Keep your originals.',
    ],
    [
      'command',
      'Menu bar and shortcuts',
      'Upload screenshots or clipboard images with shortcuts. macOS also has menu-bar controls and keeps uploading when the window closes.',
    ],
    [
      'shield',
      'Errors and queue recovery',
      'Clear error categories, a recoverable queue, and two valid backups.',
    ],
    [
      'copy',
      'Choose a link format',
      'Copy successful links automatically. Markdown, HTML, and BBCode are also available.',
    ],
    [
      'terminal',
      'AI agent integration',
      'Native CLI and Agent Skill with JSON output, per-file results, and exit codes. Reuse local storage configuration.',
    ],
  ],
);
const faq = t(
  locale,
  [
    [
      'GUI 和 CLI 要分别安装吗？',
      '不需要。GUI 已包含同版本 CLI，可以从设置里添加终端入口；只需要命令行时，也可以独立安装 CLI。',
    ],
    [
      '图片会经过 img 的服务器吗？',
      '上传由本地工具直接发往你配置的存储服务。img 不提供统一托管图床，你可以选择自己的 R2、S3、OSS、GitHub 或 HTTP 服务。',
    ],
    [
      '现在可以直接下载安装包吗？',
      '可以。安装页自动获取 GitHub Releases 最新桌面版，选择芯片后下载 DMG 即可，无需编译。',
    ],
    [
      '“64 MiB”指整个应用的内存吗？',
      '指解码后列表缩略图的缓存预算，不是应用进程的全部内存。完整的测量条件和比较方法可在对比页查看。',
    ],
  ],
  [
    [
      'Do I install the GUI and CLI separately?',
      'No. The GUI bundles the same-version CLI and can add a terminal entry point from settings. Install just the CLI if that is all you need.',
    ],
    [
      'Do images pass through an img server?',
      'Uploads go directly from your device to the storage you configure. img does not operate a shared image host. Choose your own R2, S3, OSS, GitHub, or HTTP service.',
    ],
    [
      'Can I download a ready-made package now?',
      'Yes. The installation page resolves the latest desktop release from GitHub. Choose your chip and download the DMG; no compilation is required.',
    ],
    [
      'Is 64 MiB the whole application’s memory use?',
      'It is the decoded list-thumbnail cache budget, not total process memory. See the comparison page for measurement conditions and methodology.',
    ],
  ],
);
---

<section class="hero wrap">
  <a class="release-note" href={href(locale, 'install')}
    ><span class="status-dot"></span>{
      t(locale, '社区版 · 免费开源', 'COMMUNITY · OPEN SOURCE')
    }<span class="release-divider"></span> RUST + NATIVE <Icon
      name="arrow"
      size={14}
    /></a
  >
  <h1>
    {t(locale, '从图片，', 'From image,')}<br /><span
      >{t(locale, '到链接。', 'to link.')}</span
    ><span class="hero-spark" aria-hidden="true">✳</span>
  </h1>
  <p class="hero-description">
    {
      t(
        locale,
        '上传到自有存储，自动生成图片链接。',
        'Upload to your own storage and generate image links.',
      )
    }<br />{
      t(
        locale,
        '原生桌面应用、独立 CLI 与 Agent Skill。',
        'Native desktop app, standalone CLI, and Agent Skill.',
      )
    }
  </p>
  <Actions locale={locale} /><p class="hero-footnote">
    {
      t(
        locale,
        '支持 macOS、Windows 和 Linux',
        'Available for macOS, Windows, and Linux',
      )
    }
  </p>
</section>
<section
  class="showcase wrap"
  aria-label={t(locale, '产品展示', 'Product showcase')}
>
  <div class="showcase-topline">
    <span class="mono">01 / THE WORKSPACE</span><span
      >{
        t(
          locale,
          '在图库中查找和复制已上传的图片',
          'Find uploaded images and copy their links.',
        )
      }<span class="tiny-dot"></span></span
    >
  </div>
  <div class="hero-app">
    <Screenshot locale={locale} eager caption={false} />
  </div>
  <div class="floating-terminal">
    <div class="terminal-heading">
      <span><i></i><i></i><i></i></span><span>img — zsh</span><Icon
        name="terminal"
        size={15}
      />
    </div><pre><code><span class="prompt">$</span> img photo.png --format markdown --copy
<span class="terminal-success">✓</span> <span class="terminal-muted">photo.png → your storage</span>
<span class="terminal-output">![photo.png](https://images.example.com/photo.png)</span></code></pre><div
      class="terminal-bottom"
    >
      <span class="status-dot"></span>{
        t(
          locale,
          'GUI 和 CLI 共用上传核心',
          'The GUI and CLI share an upload core.',
        )
      }<span class="mono">Rust CLI</span>
    </div>
  </div>
  <p class="showcase-caption">
    {
      t(
        locale,
        '真实原生界面 · 隔离演示数据 · 终端输出为使用示例',
        'Real native UI · Isolated demo data · Illustrative terminal output',
      )
    }
  </p>
</section>
<section
  class="metrics wrap"
  aria-label={t(locale, '轻量设计数据', 'Lightweight design data')}
>
  <div>
    <span class="metric">25.8<small>MB</small></span><p>
      {t(locale, 'GUI 安装包，已含 CLI', 'GUI package, CLI included')}
    </p><span class="metric-note">macOS ARM64 · DMG</span>
  </div>
  <div>
    <span class="metric">6.97<small>MB</small></span><p>
      {t(locale, '独立 CLI 压缩包', 'Standalone CLI archive')}
    </p><span class="metric-note">macOS ARM64 · tar.gz</span>
  </div>
  <div>
    <span class="metric">64<small>MiB</small></span><p>
      {t(locale, '列表缩略图缓存预算', 'List-thumbnail cache budget')}
    </p><span class="metric-note"
      >{t(locale, '按需加载 · LRU 释放', 'Load on demand · LRU eviction')}</span
    >
  </div>
  <a class="metric-method" href={href(locale, 'compare')}
    >{t(locale, '测量方法与来源', 'Measurement methods and sources')}<Icon
      name="external"
      size={18}
    /></a
  >
</section>
<section class="workflow-section section wrap">
  <div class="section-intro">
    <span class="eyebrow">UPLOAD WORKFLOW</span><h2>
      {t(locale, '导入、上传，拿到链接。', 'Import, upload, copy.')}
    </h2><p>
      {
        t(
          locale,
          '桌面端可先检查队列；命令行可以一次完成上传和复制。',
          'Review the queue in the app, or upload and copy with a single command.',
        )
      }
    </p>
  </div>
  <div class="workflow" data-workflow>
    <div class="workflow-steps">
      {
        steps.map(([title, description, command], i) => (
          <article class="workflow-step" data-step={i}>
            <>
              <span class="step-number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <div class="step-command">
                <>
                  <Icon name="terminal" size={17} />
                  <code>{command}</code>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <div class="workflow-visual">
      <div class="workflow-panels">
        {
          (['queue', 'settings', 'gallery'] as const).map((name, i) => (
            <div class="workflow-panel" data-panel={i}>
              <Screenshot locale={locale} name={name} caption={false} />
            </div>
          ))
        }
      </div><div class="workflow-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div><p class="fine-print">
        {
          t(
            locale,
            'GUI 与 CLI 各自操作；图中显示原生界面',
            'GUI and CLI are separate workflows; screenshots show the native app',
          )
        }
      </p>
    </div>
  </div>
</section>
<section class="storage-band">
  <div class="wrap">
    <div>
      <span class="eyebrow">STORAGE PROVIDERS</span><h2>
        {t(locale, '连接自己的存储。', 'Connect your own storage.')}
      </h2><p>
        {
          t(
            locale,
            '从自己的对象存储，到熟悉的 GitHub。一次配置，桌面和终端都能用。',
            'From object storage to GitHub. Configure once and use it from your desktop or terminal.',
          )
        }
      </p><a class="text-link" href={href(locale, 'docs/storage')}
        >{t(locale, '配置存储源', 'Configure storage')}<Icon name="arrow" /></a
      >
    </div><div class="provider-grid">
      {
        [
          'Cloudflare R2',
          'Amazon S3',
          '阿里云 OSS',
          'GitHub',
          'Custom HTTP',
        ].map((name, i) => (
          <span>
            <Icon name={i === 3 ? 'terminal' : 'folder'} size={21} />
            {name}
            <span class="provider-dot" />
          </span>
        ))
      }<span class="provider-more">S3-compatible ↗</span>
    </div>
  </div>
</section>
<section class="section wrap">
  <div class="section-intro split-intro">
    <div>
      <span class="eyebrow">FEATURES</span><h2>
        {t(locale, '日常上传会用到的功能。', 'For everyday image uploads.')}
      </h2>
    </div><a class="text-link" href={href(locale, 'features')}
      >{t(locale, '查看全部功能', 'View all features')}<Icon name="arrow" /></a
    >
  </div><div class="feature-grid">
    {
      features.map(([icon, title, description]) => (
        <article>
          <>
            <span class="feature-icon">
              <Icon name={icon} size={24} />
            </span>
            <h3>{title}</h3>
            <p>{description}</p>
          </>
        </article>
      ))
    }
  </div>
</section>
<section class="compare-home section wrap">
  <div>
    <span class="eyebrow">COMPARISON</span><h2>
      {t(locale, '包体积与功能，', 'Compare sizes')}<br />{
        t(locale, '放在一起看。', 'and features.')
      }
    </h2><p>
      {
        t(
          locale,
          'img 将原生桌面与独立 CLI 集成在同一产品中，共享存储配置和图片处理能力。对比页列出各工具的功能范围、安装包大小及数据来源，便于按工作流选择。',
          'img combines a native desktop app and standalone CLI with shared storage configuration and image processing. The comparison covers features, package sizes, and sources for evaluating each tool against your workflow.',
        )
      }
    </p><a class="text-link" href={href(locale, 'compare')}
      >{
        t(locale, '查看完整对比与来源', 'See the full comparison and sources')
      }<Icon name="arrow" /></a
    >
  </div><Comparison locale={locale} />
</section>
<section class="faq-section section wrap">
  <div>
    <span class="eyebrow">FAQ</span><h2>
      {t(locale, '常见问题', 'Common questions')}
    </h2>
  </div><div class="faq-list">
    {
      faq.map(([q, a]) => (
        <details>
          <>
            <summary>
              {q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{a}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
<section class="closing wrap">
  <span class="eyebrow">GET STARTED</span><h2>
    {t(locale, '准备好存储，', 'Set up your storage.')}<br />{
      t(locale, '试试 img。', 'Try img.')
    }
  </h2><Actions locale={locale} /><p>
    {
      t(
        locale,
        '下载社区版 · 无需编译',
        'Download the community build · No compilation',
      )
    }
  </p>
</section>
<script>
  import '../scripts/home';
</script>
