---
import Icon from './Icon.astro';
import Actions from './Actions.astro';
import Screenshot from './Screenshot.astro';
import Comparison from './Comparison.astro';
import { href, t, type Locale } from '../lib/site';
const { locale }=Astro.props as {locale:Locale};
const steps=t(locale,[['把图片放进来','拖入文件，粘贴图片，或导入外链。主窗口先入队，把决定权留给你。','img upload photo.png --provider r2'],['发往你的存储','选好存储源和处理参数，点击上传。需要的时候，可以暂停、继续和重试。','img upload photo.png --optimize --resize 1600'],['复制，继续创作','成功链接自动进入剪贴板。URL、Markdown、HTML，让每个工作流都顺手。','img upload photo.png --format markdown --copy']],[['Bring your images','Drop files, paste an image, or import a URL. In the main window, imports wait until you are ready.','img upload photo.png --provider r2'],['Send to your storage','Choose storage and processing options, then upload. Pause, resume, or retry when you need to.','img upload photo.png --optimize --resize 1600'],['Copy. Keep creating.','Successful links go straight to your clipboard. URL, Markdown, or HTML: ready for your workflow.','img upload photo.png --format markdown --copy']]);
const features=t(locale,[['image','有条理的图库','网格与列表自由切换，搜索记录，随时找回已上传的图片。'],['sliders','恰好的图片处理','压缩、缩放、清理 JPEG EXIF。上传前处理，保留原文件。'],['command','少几步，更顺手','菜单栏与全局快捷操作。关掉窗口，上传还在继续。'],['shield','失败也有下一步','清楚的错误分类，可恢复的队列，两份有效备份。'],['copy','链接，按你习惯的格式','自动复制成功链接，也支持 Markdown、HTML 与 BBCode。'],['terminal','从终端到编辑器','独立 Rust CLI、JSON、编辑器代理和 Markdown 批量转存。']],[['image','A library that stays useful','Switch between grids and lists, search records, and find uploaded images again.'],['sliders','Just enough image processing','Compress, resize, and remove JPEG EXIF before upload. Keep your originals.'],['command','Fewer steps, more flow','Menu-bar and global quick actions. Close the window; uploads keep going.'],['shield','A way forward after failure','Clear error categories, a recoverable queue, and two valid backups.'],['copy','Links in your language','Copy successful links automatically. Markdown, HTML, and BBCode are also available.'],['terminal','From shell to editor','A standalone Rust CLI, JSON output, an editor proxy, and Markdown rewriting.']]);
const faq=t(locale,[['GUI 和 CLI 要分别安装吗？','不需要。GUI 已包含同版本 CLI，可以从设置里添加终端入口；只需要命令行时，也可以独立安装 CLI。'],['图片会经过 img 的服务器吗？','上传由本地工具直接发往你配置的存储服务。img 不提供统一托管图床，你可以选择自己的 R2、S3、OSS、GitHub 或 HTTP 服务。'],['现在可以直接下载安装包吗？','0.3.0 目前是内测预览，官网提供源码构建指南。本轮尚未发布安装包，旧 v0.2.0 仍是 Go 版本。'],['“64 MiB”指整个应用的内存吗？','指解码后列表缩略图的缓存预算，不是应用进程的全部内存。完整的测量条件和比较方法可在对比页查看。']],[['Do I install the GUI and CLI separately?','No. The GUI bundles the same-version CLI and can add a terminal entry point from settings. Install just the CLI if that is all you need.'],['Do images pass through an img server?','Uploads go directly from your device to the storage you configure. img does not operate a shared image host. Choose your own R2, S3, OSS, GitHub, or HTTP service.'],['Can I download a ready-made package now?','0.3.0 is a preview with source-build instructions. No installer release is published for this version yet; the older v0.2.0 is the Go implementation.'],['Is 64 MiB the whole application’s memory use?','It is the decoded list-thumbnail cache budget, not total process memory. See the comparison page for measurement conditions and methodology.']]);
---
<section class="hero wrap">
  <a class="release-note" href={href(locale,'install')}><span class="status-dot"></span>0.3.0 {t(locale,'内测预览','PREVIEW')}<span class="release-divider"></span> RUST + NATIVE <Icon name="arrow" size={14}/></a>
  <h1>{t(locale,'从图片，','From image,')}<br/><span>{t(locale,'到链接。','to link.')}</span><span class="hero-spark" aria-hidden="true">✳</span></h1>
  <p class="hero-description">{t(locale,'一个轻巧的图片上传工具。','A small tool for your images.')}<br/>{t(locale,'原生桌面的从容，命令行的利落。','The ease of a native app. The precision of a CLI.')}</p>
  <Actions locale={locale}/><p class="hero-footnote">{t(locale,'macOS GUI · 跨平台 CLI · 你的图片，你的存储','macOS GUI · Cross-platform CLI · Your images, your storage')}</p>
</section>
<section class="showcase wrap" aria-label={t(locale,'产品展示','Product showcase')}>
  <div class="showcase-topline"><span class="mono">01 / THE WORKSPACE</span><span>{t(locale,'轻松放进去，随时找回来','Easy to add. Easy to find again.')}<span class="tiny-dot"></span></span></div>
  <div class="hero-app"><Screenshot locale={locale} eager caption={false}/></div>
  <div class="floating-terminal"><div class="terminal-heading"><span><i></i><i></i><i></i></span><span>img — zsh</span><Icon name="terminal" size={15}/></div><pre><code><span class="prompt">$</span> img photo.png --format markdown --copy
<span class="terminal-success">✓</span> <span class="terminal-muted">photo.png → your storage</span>
<span class="terminal-output">![photo.png](https://images.example.com/photo.png)</span></code></pre><div class="terminal-bottom"><span class="status-dot"></span>{t(locale,'同一核心，两种工作方式','One core. Two ways to work.')}<span class="mono">CLI 0.3.0</span></div></div>
  <p class="showcase-caption">{t(locale,'真实原生界面 · 隔离演示数据 · 终端输出为使用示例','Real native UI · Isolated demo data · Illustrative terminal output')}</p>
</section>
<section class="metrics wrap" aria-label={t(locale,'轻量设计数据','Lightweight design data')}>
  <div><span class="metric">25.8<small>MB</small></span><p>{t(locale,'GUI 安装包，已含 CLI','GUI package, CLI included')}</p><span class="metric-note">macOS ARM64 · DMG</span></div>
  <div><span class="metric">6.97<small>MB</small></span><p>{t(locale,'独立 CLI 压缩包','Standalone CLI archive')}</p><span class="metric-note">macOS ARM64 · tar.gz</span></div>
  <div><span class="metric">64<small>MiB</small></span><p>{t(locale,'列表缩略图缓存预算','List-thumbnail cache budget')}</p><span class="metric-note">{t(locale,'按需加载 · LRU 释放','Load on demand · LRU eviction')}</span></div>
  <a class="metric-method" href={href(locale,'compare')}>{t(locale,'数字背后的方法','Behind the numbers')}<Icon name="external" size={18}/></a>
</section>
<section class="workflow-section section wrap">
  <div class="section-intro"><span class="eyebrow">LESS FRICTION. MORE FLOW.</span><h2>{t(locale,'三步，回到创作。','Three steps. Back to creating.')}</h2><p>{t(locale,'把重复的动作变简单，把注意力留给重要的事。','Make the repetitive part simple. Keep your attention on the work.')}</p></div>
  <div class="workflow" data-workflow>
    <div class="workflow-steps">{steps.map(([title,description,command],i)=><article class="workflow-step" data-step={i}><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{description}</p><div class="step-command"><Icon name="terminal" size={17}/><code>{command}</code></div></article>)}</div>
    <div class="workflow-visual"><div class="workflow-panels">{(['queue','settings','gallery'] as const).map((name,i)=><div class="workflow-panel" data-panel={i}><Screenshot locale={locale} name={name} caption={false}/></div>)}</div><div class="workflow-dots" aria-hidden="true"><span></span><span></span><span></span></div><p class="fine-print">{t(locale,'GUI 与 CLI 各自操作；图中显示原生界面','GUI and CLI are separate workflows; screenshots show the native app')}</p></div>
  </div>
</section>
<section class="storage-band"><div class="wrap"><div><span class="eyebrow">YOUR IMAGES. YOUR STORAGE.</span><h2>{t(locale,'存到哪里，你说了算。','Your storage. Your choice.')}</h2><p>{t(locale,'从自己的对象存储，到熟悉的 GitHub。一次配置，桌面和终端都能用。','From object storage to GitHub. Configure once and use it from your desktop or terminal.')}</p><a class="text-link" href={href(locale,'docs/storage')}>{t(locale,'配置存储源','Configure storage')}<Icon name="arrow"/></a></div><div class="provider-grid">{['Cloudflare R2','Amazon S3','阿里云 OSS','GitHub','Custom HTTP'].map((name,i)=><span><Icon name={i===3?'terminal':'folder'} size={21}/>{name}<span class="provider-dot"></span></span>)}<span class="provider-more">S3-compatible ↗</span></div></div></section>
<section class="section wrap"><div class="section-intro split-intro"><div><span class="eyebrow">SMALL TOOL. THOUGHTFUL DETAILS.</span><h2>{t(locale,'轻巧，也周到。','Small. Not bare-bones.')}</h2></div><a class="text-link" href={href(locale,'features')}>{t(locale,'探索全部功能','Explore all features')}<Icon name="arrow"/></a></div><div class="feature-grid">{features.map(([icon,title,description])=><article><span class="feature-icon"><Icon name={icon} size={24}/></span><h3>{title}</h3><p>{description}</p></article>)}</div></section>
<section class="compare-home section wrap"><div><span class="eyebrow">A LITTLE LESS TO CARRY.</span><h2>{t(locale,'轻装上阵，','Less to carry.')}<br/>{t(locale,'各有所长。','Room to choose.')}</h2><p>{t(locale,'img 专注本地上传与原生命令行。也有工具更擅长插件扩展、远端图库或 macOS 系统集成。选适合你的。','img focuses on local uploads and a standalone native CLI. Other tools shine at plugins, remote libraries, or macOS integration. Choose what fits.')}</p><a class="text-link" href={href(locale,'compare')}>{t(locale,'查看完整对比与来源','See the full comparison and sources')}<Icon name="arrow"/></a></div><Comparison locale={locale}/></section>
<section class="faq-section section wrap"><div><span class="eyebrow">A FEW GOOD QUESTIONS.</span><h2>{t(locale,'你可能想知道。','Good to know.')}</h2></div><div class="faq-list">{faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<section class="closing wrap"><span class="eyebrow">READY WHEN YOU ARE.</span><h2>{t(locale,'下一张图片，','Your next image.')}<br/>{t(locale,'试试 img。','Meet img.')}</h2><Actions locale={locale}/><p>{t(locale,'0.3.0 内测预览 · 从源码开始','0.3.0 preview · Start from source')}</p></section>
<script>import '../scripts/home';</script>
