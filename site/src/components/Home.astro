---
import Icon from './Icon.astro';
import Actions from './Actions.astro';
import Screenshot from './Screenshot.astro';
import Comparison from './Comparison.astro';
import { evidence } from '../lib/comparison';
import { href, t, type Locale } from '../lib/site';
const { locale } = Astro.props as { locale: Locale };
const steps = t(
  locale,
  [
    [
      '导入图片',
      '拖入文件、粘贴图片或导入图片链接。主窗口会先把图片加入队列，点击上传后才发送。',
      'img upload photo.png --provider r2',
    ],
    [
      '选择存储并上传',
      '选好存储源和处理参数，点击上传。需要的时候，可以暂停、继续和重试。',
      'img upload photo.png --optimize --resize 1600',
    ],
    [
      '复制链接',
      '上传成功后自动复制链接。可选 URL、Markdown 或 HTML，直接粘贴到文章里。',
      'img upload photo.png --format markdown --copy',
    ],
  ],
  [
    [
      'Import images',
      'Drop files, paste an image, or import a URL. In the main window, imports wait until you are ready.',
      'img upload photo.png --provider r2',
    ],
    [
      'Send to your storage',
      'Choose storage and processing options, then upload. Pause, resume, or retry when you need to.',
      'img upload photo.png --optimize --resize 1600',
    ],
    [
      'Copy the links',
      'After uploading, copy links automatically as URLs, Markdown, or HTML and paste them into your document.',
      'img upload photo.png --format markdown --copy',
    ],
  ],
);
const features = t(
  locale,
  [
    [
      'image',
      '图库与历史',
      '网格与列表自由切换，搜索记录，随时找回已上传的图片。',
    ],
    [
      'sliders',
      '上传前处理图片',
      '压缩、缩放、清理 JPEG EXIF。上传前处理，保留原文件。',
    ],
    [
      'command',
      '菜单栏与快捷键',
      '快捷键直接上传剪贴板或截图。macOS 还支持菜单栏操作和关闭窗口后继续上传。',
    ],
    [
      'shield',
      '错误提示与队列恢复',
      '清楚的错误分类，可恢复的队列，两份有效备份。',
    ],
    [
      'copy',
      '选择复制格式',
      '自动复制成功链接，也支持 Markdown、HTML 与 BBCode。',
    ],
    [
      'terminal',
      'Markdown 图片转存',
      '批量上传文章中的本地图片与外链图片，替换引用并保留 alt 和 title。',
    ],
  ],
  [
    [
      'image',
      'Library and history',
      'Switch between grids and lists, search records, and find uploaded images again.',
    ],
    [
      'sliders',
      'Process images before upload',
      'Compress, resize, and remove JPEG EXIF before upload. Keep your originals.',
    ],
    [
      'command',
      'Menu bar and shortcuts',
      'Upload screenshots or clipboard images with shortcuts. macOS also has menu-bar controls and keeps uploading when the window closes.',
    ],
    [
      'shield',
      'Errors and queue recovery',
      'Clear error categories, a recoverable queue, and two valid backups.',
    ],
    [
      'copy',
      'Choose a link format',
      'Copy successful links automatically. Markdown, HTML, and BBCode are also available.',
    ],
    [
      'terminal',
      'Markdown image migration',
      'Upload local and remote images from an article, replacing references while preserving alt text and titles.',
    ],
  ],
);
const faq = t(
  locale,
  [
    [
      'GUI 和 CLI 要分别安装吗？',
      '不需要。GUI 已包含同版本 CLI，可以从设置里添加终端入口；只需要命令行时，也可以独立安装 CLI。',
    ],
    [
      '图片会经过 img 的服务器吗？',
      '上传由本地工具直接发往你配置的存储服务。img 不提供统一托管图床，你可以选择自己的 R2、S3、OSS、GitHub 或 HTTP 服务。',
    ],
    [
      '支持哪些操作系统？',
      '桌面版支持 macOS 13+（Apple silicon / Intel）、Windows x64，以及 Ubuntu 24.04 / Debian 13+ x64。独立 CLI 另提供 Linux ARM64。安装页按系统列出最新稳定版。',
    ],
    [
      '已有图床和文章链接需要迁移吗？',
      '支持的存储服务和公开域名可以继续使用。在 img 中添加配置并验证上传后，即可调整编辑器入口；已有文章链接不受影响。目前不支持自动导入其他客户端的配置与历史记录。',
    ],
  ],
  [
    [
      'Do I install the GUI and CLI separately?',
      'No. The GUI bundles the same-version CLI and can add a terminal entry point from settings. Install just the CLI if that is all you need.',
    ],
    [
      'Do images pass through an img server?',
      'Uploads go directly from your device to the storage you configure. img does not operate a shared image host. Choose your own R2, S3, OSS, GitHub, or HTTP service.',
    ],
    [
      'Which operating systems are supported?',
      'The desktop app supports macOS 13+ on Apple silicon and Intel, Windows x64, and Ubuntu 24.04 / Debian 13+ x64. The standalone CLI also supports Linux ARM64. The installation page lists current stable packages by system.',
    ],
    [
      'Do I need to migrate my storage or existing links?',
      'Keep supported storage services and your public domain. Add the configuration in img and verify an upload before changing your editor integration. Existing article links remain unchanged. Configuration and history imports from other clients are not supported.',
    ],
  ],
);
---

<section class="hero wrap">
  <a class="release-note" href={href(locale, 'install')}
    ><span class="status-dot"></span>{
      t(locale, '社区版 · 免费开源', 'COMMUNITY · OPEN SOURCE')
    }<span class="release-divider"></span> RUST + NATIVE <Icon
      name="arrow"
      size={14}
    /></a
  >
  <h1 class="product-title">
    {t(locale, '原生图片', 'Native image')}<br /><span
      >{t(locale, '上传工具', 'uploader')}</span
    >
  </h1>
  <p class="hero-description">
    {
      t(
        locale,
        '面向写作与自动化，将图片上传到自有存储并生成链接。',
        'Upload images to your own storage for publishing and automation.',
      )
    }<br />{
      t(
        locale,
        '原生桌面、独立 CLI 与 Agent Skill 共享存储配置。',
        'Native desktop, standalone CLI, and Agent Skill with shared storage configuration.',
      )
    }
  </p>
  <Actions locale={locale} /><p class="hero-footnote">
    {
      t(
        locale,
        '支持 macOS、Windows 和 Linux',
        'Available for macOS, Windows, and Linux',
      )
    }
  </p>
</section>
<section
  class="showcase wrap"
  aria-label={t(locale, '产品展示', 'Product showcase')}
>
  <div class="showcase-topline">
    <span class="mono">01 / THE WORKSPACE</span><span
      >{
        t(
          locale,
          '在图库中查找和复制已上传的图片',
          'Find uploaded images and copy their links.',
        )
      }<span class="tiny-dot"></span></span
    >
  </div>
  <div class="hero-app">
    <Screenshot locale={locale} eager caption={false} />
  </div>
  <div class="floating-terminal">
    <div class="terminal-heading">
      <span><i></i><i></i><i></i></span><span>img — zsh</span><Icon
        name="terminal"
        size={15}
      />
    </div><pre><code><span class="prompt">$</span> img photo.png --format markdown --copy
<span class="terminal-success">✓</span> <span class="terminal-muted">photo.png → your storage</span>
<span class="terminal-output">![photo.png](https://images.example.com/photo.png)</span></code></pre><div
      class="terminal-bottom"
    >
      <span class="status-dot"></span>{
        t(
          locale,
          'GUI 和 CLI 共用上传核心',
          'The GUI and CLI share an upload core.',
        )
      }<span class="mono">Rust CLI</span>
    </div>
  </div>
  <p class="showcase-caption">
    {
      t(
        locale,
        'macOS 桌面界面，使用演示数据；终端为命令示例。',
        'macOS desktop with demo data. Terminal shows an example command.',
      )
    }
  </p>
</section>
<section
  class="metrics wrap"
  aria-label={t(locale, '安装与平台', 'Packages and platforms')}
>
  <div>
    <span class="metric"
      >{(evidence.products[0].bytes! / 1e6).toFixed(1)}<small>MB</small></span
    ><p>
      {t(locale, 'GUI 安装包，已含 CLI', 'GUI package, CLI included')}
    </p><span class="metric-note">macOS ARM64 · DMG</span>
  </div>
  <div>
    <span class="metric"
      >{(evidence.cli.bytes / 1e6).toFixed(2)}<small>MB</small></span
    ><p>
      {t(locale, '独立 CLI 压缩包', 'Standalone CLI archive')}
    </p><span class="metric-note">macOS ARM64 · tar.gz</span>
  </div>
  <div>
    <span class="metric"
      >3<small>{t(locale, '个平台', 'platforms')}</small></span
    ><p>
      {t(locale, '原生桌面与独立 CLI', 'Native desktop and standalone CLI')}
    </p><span class="metric-note">macOS · Windows · Linux</span>
  </div>
  <a class="metric-method" href={href(locale, 'compare')}
    >{t(locale, '测量方法与来源', 'Measurement methods and sources')}<Icon
      name="external"
      size={18}
    /></a
  >
</section>
<section class="workflow-section section wrap">
  <div class="section-intro">
    <span class="eyebrow">UPLOAD WORKFLOW</span><h2>
      {t(locale, '桌面上传', 'Desktop uploads')}
    </h2><p>
      {
        t(
          locale,
          '在窗口中管理批量上传，或通过快捷键直接上传剪贴板和截图。完成后自动复制链接。',
          'Manage batch uploads in the app, or upload clipboard images and screenshots with a shortcut. Links are copied when uploads complete.',
        )
      }
    </p>
  </div>
  <div class="workflow" data-workflow>
    <div class="workflow-steps">
      {
        steps.map(([title, description, command], i) => (
          <article class="workflow-step" data-step={i}>
            <>
              <span class="step-number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <div class="step-command">
                <>
                  <Icon name="terminal" size={17} />
                  <code>{command}</code>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <div class="workflow-visual">
      <div class="workflow-panels">
        {
          (['queue', 'settings', 'gallery'] as const).map((name, i) => (
            <div class="workflow-panel" data-panel={i}>
              <Screenshot locale={locale} name={name} caption={false} />
            </div>
          ))
        }
      </div><div class="workflow-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div><p class="fine-print">
        {
          t(
            locale,
            'GUI 与 CLI 各自操作；图中显示原生界面',
            'GUI and CLI are separate workflows; screenshots show the native app',
          )
        }
      </p>
    </div>
  </div>
</section>
<section class="agent-section section wrap" id="automation">
  <div class="agent-intro">
    <span class="eyebrow">CLI &amp; AGENT SKILL</span>
    <h2>{t(locale, '接入自动化工作流', 'Integrate with your workflow')}</h2>
    <p>
      {
        t(
          locale,
          '独立 CLI 可直接用于脚本、编辑器和 AI Agent，无需启动桌面应用。上传结果以 JSON 返回，便于读取链接、判断失败并继续后续任务。',
          'The standalone CLI works with scripts, editors, and AI agents without launching the desktop app. JSON results expose uploaded URLs and failures for subsequent tasks.',
        )
      }
    </p>
    <p>
      {
        t(
          locale,
          'Agent Skill 定义文件检查、配置校验和上传流程，复用已配置的存储源。适用于支持 Agent Skills 且能够执行本地命令的助手。',
          'The Agent Skill defines file checks, configuration validation, and uploads using existing storage settings. It works with assistants that support Agent Skills and local command execution.',
        )
      }
    </p>
    <a class="text-link" href={href(locale, 'docs/integrations')}
      >{t(locale, '查看集成文档', 'Integration guide')}<Icon name="arrow" /></a
    >
  </div>
  <div class="agent-examples">
    <div class="agent-code">
      <span class="mono"
        >{
          t(locale, '上传图片 · JSON 输出', 'Upload an image · JSON output')
        }</span
      >
      <pre><code>img upload ./assets/chart.png --format json --no-copy</code></pre>
    </div>
    <div class="agent-code">
      <span class="mono"
        >{t(locale, '安装 Agent Skill', 'Install the Agent Skill')}</span
      >
      <pre><code>npx skills add liyown/img --skill img-uploader</code></pre>
    </div>
    <p class="fine-print">
      {
        t(
          locale,
          '使用前安装 CLI 并配置默认存储源。Skill 调用本地配置，无需在提示词中提供凭据。',
          'Install the CLI and configure a default provider first. The Skill uses local configuration; credentials do not belong in prompts.',
        )
      }
    </p>
  </div>
</section>
<section class="storage-band">
  <div class="wrap">
    <div>
      <span class="eyebrow">STORAGE PROVIDERS</span><h2>
        {t(locale, '支持自有存储', 'Use your own storage')}
      </h2><p>
        {
          t(
            locale,
            '连接对象存储、GitHub 仓库或自定义 HTTP 服务，沿用现有公开域名。桌面与 CLI 共享配置，支持按项目选择存储源。',
            'Connect object storage, a GitHub repository, or a custom HTTP service with your existing public domain. Desktop and CLI share configuration, with provider selection per project.',
          )
        }
      </p><a class="text-link" href={href(locale, 'docs/storage')}
        >{t(locale, '配置存储源', 'Configure storage')}<Icon name="arrow" /></a
      >
    </div><div class="provider-grid">
      {
        [
          'Cloudflare R2',
          'Amazon S3',
          '阿里云 OSS',
          'GitHub',
          'Custom HTTP',
        ].map((name, i) => (
          <span>
            <Icon name={i === 3 ? 'terminal' : 'folder'} size={21} />
            {name}
            <span class="provider-dot" />
          </span>
        ))
      }<span class="provider-more">S3-compatible ↗</span>
    </div>
  </div>
</section>
<section class="section wrap">
  <div class="section-intro split-intro">
    <div>
      <span class="eyebrow">FEATURES</span><h2>
        {t(locale, '图库与图片处理', 'Library and image processing')}
      </h2>
    </div><a class="text-link" href={href(locale, 'features')}
      >{t(locale, '查看全部功能', 'View all features')}<Icon name="arrow" /></a
    >
  </div><div class="feature-grid">
    {
      features.map(([icon, title, description]) => (
        <article>
          <>
            <span class="feature-icon">
              <Icon name={icon} size={24} />
            </span>
            <h3>{title}</h3>
            <p>{description}</p>
          </>
        </article>
      ))
    }
  </div>
</section>
<section class="compare-home section wrap">
  <div>
    <span class="eyebrow">COMPARISON</span><h2>
      {t(locale, '安装包与功能对比', 'Packages and features')}
    </h2><p>
      {
        t(
          locale,
          'img 将原生桌面与独立 CLI 集成在同一产品中，共享存储配置和图片处理能力。对比页列出各工具的功能范围、安装包大小及数据来源，便于按工作流选择。',
          'img combines a native desktop app and standalone CLI with shared storage configuration and image processing. The comparison covers features, package sizes, and sources for evaluating each tool against your workflow.',
        )
      }
    </p><a class="text-link" href={href(locale, 'compare')}
      >{
        t(locale, '查看完整对比与来源', 'See the full comparison and sources')
      }<Icon name="arrow" /></a
    >
  </div><Comparison locale={locale} />
</section>
<section class="faq-section section wrap">
  <div>
    <span class="eyebrow">FAQ</span><h2>
      {t(locale, '常见问题', 'Common questions')}
    </h2>
  </div><div class="faq-list">
    {
      faq.map(([q, a]) => (
        <details>
          <>
            <summary>
              {q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{a}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
<section class="closing wrap">
  <span class="eyebrow">GET STARTED</span><h2>
    {t(locale, '下载 img', 'Download img')}
  </h2><Actions locale={locale} /><p>
    {
      t(
        locale,
        '下载社区版 · 无需编译',
        'Download the community build · No compilation',
      )
    }
  </p>
</section>
<script>
  import '../scripts/home';
</script>
