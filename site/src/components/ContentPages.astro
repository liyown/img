---
import { Code } from 'astro:components';
import Icon from './Icon.astro';
import Screenshot from './Screenshot.astro';
import Actions from './Actions.astro';
import Comparison from './Comparison.astro';
import { evidence } from '../lib/comparison';
import { href, t, site, type Locale } from '../lib/site';
const { locale, path }=Astro.props as {locale:Locale,path:string};
const features=t(locale,[['image','图库与历史','在网格和列表之间切换。搜索文件名、存储源和链接，打开大图预览，复制需要的结果。','gallery'],['layers','真正可控的上传队列','手动导入先入队，再点击上传。并发、暂停、取消、重试与服务器确认，把每张图的状态说明白。','queue'],['sliders','设置就在界面里','存储源、上传与图片处理、链接与剪贴板、应用偏好、关于与更新，各归其位。','settings']],[['image','Library and history','Switch between grids and lists. Search names, storage providers, and links; enlarge previews and copy results.','gallery'],['layers','A queue you control','Manual imports wait for Upload. Concurrency, pause, cancel, retry, and server confirmation keep each image’s state clear.','queue'],['sliders','Settings in the interface','Dedicated sections for storage, processing, links and clipboard, app preferences, and about and updates.','settings']]);
const rows=t(locale,[['桌面平台','macOS','macOS / Windows / Linux','macOS / Windows / Linux','macOS'],['桌面技术','Rust / GPUI 原生','Electron','Electron','原生 macOS'],['CLI','独立 Rust 二进制；GUI 内置','PicGo-Core（Node.js）','PicList-Core（Node.js）','支持命令行调用'],['存储选择','R2 / S3 / OSS / GitHub / HTTP','内置图床 + 插件生态','内置图床 + 插件生态','内置图床 + 自定义服务'],['自动复制与截图','支持','支持','支持','支持'],['远端文件管理','未提供','云端相册能力','远端搜索、删除与批量管理','以上传与本地历史为主'],['进程内存 / 启动时间','暂无可比实测','暂无可比实测','暂无可比实测','暂无可比实测']],[['Desktop platforms','macOS','macOS / Windows / Linux','macOS / Windows / Linux','macOS'],['Desktop technology','Rust / native GPUI','Electron','Electron','Native macOS'],['CLI','Standalone Rust binary; bundled with GUI','PicGo-Core (Node.js)','PicList-Core (Node.js)','Command-line invocation'],['Storage','R2 / S3 / OSS / GitHub / HTTP','Built-in providers + plugins','Built-in providers + plugins','Built-in + custom services'],['Auto-copy and screenshots','Supported','Supported','Supported','Supported'],['Remote file management','Not provided','Cloud album capabilities','Remote search, deletion, batch management','Focus on uploading and local history'],['Process memory / startup','No comparable measurement','No comparable measurement','No comparable measurement','No comparable measurement']]);
---
{path==='features' && <>
  <section class="page-hero wrap"><span class="eyebrow">MADE FOR THE EVERYDAY.</span><h1>{t(locale,'简单的事，','Simple things,')}<br/><em>{t(locale,'认真做好。','done thoughtfully.')}</em></h1><p>{t(locale,'从第一次上传，到每一天的创作。把日常会用到的细节，放进一个轻巧的工具里。','From your first upload to your everyday routine. Useful details in one small tool.')}</p></section>
  <div class="wrap feature-stories">{features.map(([icon,title,desc,shot],i)=><section class="feature-story"><div><span class="eyebrow">0{i+1} / <Icon name={icon}/></span><h2>{title}</h2><p>{desc}</p><a class="text-link" href={href(locale,'docs/desktop')}>{t(locale,'查看桌面指南','Read the desktop guide')}<Icon name="arrow"/></a></div><Screenshot locale={locale} name={shot as 'gallery'|'queue'|'settings'}/></section>)}</div>
  <section class="section wrap"><div class="section-intro"><span class="eyebrow">UNDER THE SURFACE.</span><h2>{t(locale,'看得到的轻巧，看不到的用心。','Small on the surface. Considered underneath.')}</h2></div><div class="feature-grid">
    {t(locale,[['bolt','按需渲染','队列、历史与图库按可见区域渲染，列表缩略图最长边 512 px，解码缓存预算 64 MiB。'],['shield','队列恢复','单一后台写入器串行原子保存，两份有效备份。损坏时先恢复，再上传。'],['sliders','图片处理','PNG / JPEG 压缩、最大宽度缩放、JPEG EXIF / GPS 清理。处理的是上传副本。'],['command','后台快捷操作','菜单栏、全局快捷键与批次通知。窗口隐藏后仍可继续上传；部分系统交互仍在内测验收。'],['terminal','一个 Rust 核心','独立 CLI 与 GUI 随附 CLI 来自同一实现。无需额外安装 Node.js、Go 或 Rust 运行时。'],['folder','存储属于你','直接连接自己的 R2、S3、OSS、GitHub 或 HTTP。桌面新增凭据保存在 macOS 钥匙串。']],[['bolt','Render what is visible','Virtual queue, history, and gallery views. List thumbnails up to 512 px, with a 64 MiB decoded-cache budget.'],['shield','Queue recovery','One serialized atomic writer and two valid backups. Recover a damaged queue before uploading.'],['sliders','Image processing','PNG/JPEG optimization, maximum-width resizing, and JPEG EXIF/GPS removal. Your originals stay intact.'],['command','Background quick actions','Menu bar, global shortcuts, and batch notifications. Upload while hidden; some OS interactions remain under preview acceptance.'],['terminal','One Rust core','The standalone and bundled CLI share an implementation. No extra Node.js, Go, or Rust runtime after installation.'],['folder','Storage stays yours','Connect directly to your R2, S3, OSS, GitHub, or HTTP service. New desktop credentials are stored in macOS Keychain.']]).map(([icon,title,body])=><article><span class="feature-icon"><Icon name={icon}/></span><h3>{title}</h3><p>{body}</p></article>)}
  </div></section><section class="closing wrap"><h2>{t(locale,'选你顺手的方式。','Choose your way to work.')}</h2><Actions locale={locale}/></section>
</>}
{path==='compare' && <>
  <section class="page-hero wrap"><span class="eyebrow">CONTEXT, NOT JUST NUMBERS.</span><h1>{t(locale,'轻一点，','A little lighter.')}<br/><em>{t(locale,'也看全面一点。','The full picture.')}</em></h1><p>{t(locale,'img、PicGo、PicList 和 uPic，各有适合的工作方式。用同口径的数据，做有依据的选择。','img, PicGo, PicList, and uPic suit different workflows. Compare the context as well as the numbers.')}</p></section>
  <section class="wrap comparison-main"><Comparison locale={locale}/><div class="comparison-aside"><span class="eyebrow">ONE MORE OPTION.</span><h2>6.97 <small>MB</small></h2><p>{t(locale,'只要命令行？独立 CLI 的 macOS ARM64 tar.gz 约 6.97 MB。没有 GUI 依赖，也无需额外语言运行时。','Only need a terminal? The standalone CLI’s macOS ARM64 tar.gz is about 6.97 MB. No GUI dependencies or extra language runtime.')}</p><a class="text-link" href={href(locale,'install')+'#cli'}>{t(locale,'构建独立 CLI','Build the standalone CLI')}<Icon name="arrow"/></a></div></section>
  <section class="section wrap"><div class="section-intro"><span class="eyebrow">FIND YOUR FIT.</span><h2>{t(locale,'功能与使用场景','Features and fit')}</h2></div><div class="table-scroll" tabindex="0" role="region" aria-label={t(locale,'可横向滚动的功能比较表','Horizontally scrollable feature comparison')}><table class="comparison-table"><thead><tr><th scope="col">{t(locale,'比较项','Capability')}</th>{['img','PicGo','PicList','uPic'].map(n=><th scope="col">{n}</th>)}</tr></thead><tbody>{rows.map(([label,...values])=><tr><th scope="row">{label}</th>{values.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div><p class="fine-print">{t(locale,'img 0.3.0 内测、PicGo 3.0.2、PicList 3.5.0；uPic 按官方项目及 App Store 分发说明，GitHub v0.21.1 不代表最新 App Store 版。核验日期：2026-09-07。','img 0.3.0 preview, PicGo 3.0.2, PicList 3.5.0; uPic follows its official project and App Store distribution notes. GitHub v0.21.1 is not the latest App Store version. Checked Sep 7, 2026.')}</p>
    <div class="fit-grid">{t(locale,[['img','希望同时使用原生 GUI 和独立 CLI，看重本地队列恢复、公开源码与小包体。'],['PicGo','需要跨平台桌面与成熟插件生态，想接入更多图床和已有工作流。'],['PicList','需要更多云端文件管理、远程搜索、批量操作和图片处理。'],['uPic','专注 macOS 上传，喜欢原生系统集成、菜单栏和快捷操作。']],[['img','For a native GUI plus a standalone CLI, recoverable local queues, public source, and a small package.'],['PicGo','For cross-platform desktops, a mature plugin ecosystem, and many storage integrations.'],['PicList','For richer remote file management, cloud search, batch operations, and image processing.'],['uPic','For a macOS-focused uploader with native integration, menu-bar access, and quick actions.']]).map(([name,body])=><article><h3>{name}</h3><p>{body}</p></article>)}</div>
  </section>
  <section class="benchmark-section"><div class="wrap"><span class="eyebrow">MEASURED ON IMG.</span><h2>{t(locale,'一万条记录下的表现。','With ten thousand records.')}</h2><div class="benchmark-values"><div><strong>0.039 <small>ms</small></strong><p>{t(locale,'搜索计算耗时 P95','Search computation P95')}</p></div><div><strong>3.652 <small>ms</small></strong><p>{t(locale,'GPUI CPU 绘制耗时 P95','GPUI CPU draw time P95')}</p></div><div><strong>64 <small>MiB</small></strong><p>{t(locale,'缩略图缓存预算与峰值','Thumbnail cache budget and peak')}</p></div></div><p>{t(locale,'Apple M4 · 16 GiB · macOS 27.0 (26A5388g) · release 构建 · 299 个绘制样本。10,000 条不同 ID 与路径的记录，使用相同的 1200 × 900 PNG 内容。','Apple M4 · 16 GiB · macOS 27.0 (26A5388g) · release build · 299 draw samples. 10,000 distinct record IDs and paths using identical 1200 × 900 PNG content.')}</p><p class="fine-print">{t(locale,'这些是 img 自身的微基准，不是竞品测速。搜索计算不等于输入到显示的延迟；CPU 绘制不等于 GPU 完成或端到端帧率；64 MiB 不等于进程总内存。上传速度取决于图片、网络和存储服务。','These are img’s own microbenchmarks, not competitor tests. Search computation is not input-to-display latency; CPU draw time is not GPU completion or end-to-end frame rate; 64 MiB is not total process memory. Upload speed depends on images, network, and storage.')}</p><a class="text-link" href={evidence.benchmark.source}>{t(locale,'查看测试方法与未完成验收','Read the method and remaining acceptance work')}<Icon name="external"/></a></div></section>
  <section class="section wrap prose sources"><h2>{t(locale,'数据来源与口径','Sources and methodology')}</h2><p>{t(locale,'包体积统一使用字节数除以 1,000,000。img 为本地开发签名包，PicGo 与 PicList 来自官方 release 清单；签名方式、资源内容与功能范围可能不同，大小不能单独代表质量。uPic 缺少同版本同架构 DMG 数据，保留为空。没有可靠来源的竞品内存和启动速度不填估计数。','Package sizes use bytes divided by 1,000,000. img is a local development-signed package; PicGo and PicList use official release manifests. Signing, resources, and feature scope differ, so size alone does not indicate quality. No comparable current uPic ARM64 DMG is available. Unsupported memory and startup estimates are left blank.')}</p><ul>{evidence.products.map(p=><li><a href={p.source}>{p.name} · {p.version} · {t(locale,p.kind==='local-artifact'?'本地构建记录':p.kind==='official-manifest'?'官方安装包清单':'官方项目说明',p.kind==='local-artifact'?'Local build record':p.kind==='official-manifest'?'Official package manifest':'Official project')}</a></li>)}<li><a href="https://github.com/Molunerfinn/PicGo/releases/tag/v3.0.2">PicGo 3.0.2 {t(locale,'功能与发行说明','features and release notes')}</a></li><li><a href="https://piclist.cn/en/app">PicList {t(locale,'官方功能说明','official features')}</a></li><li><a href="https://picgo.github.io/PicGo-Core-Doc/guide/getting-started.html">PicGo-Core CLI</a></li><li><a href="https://piclist.cn/en/app#piclist-core">PicList-Core CLI</a></li></ul></section>
</>}
{path==='install' && <>
  <section class="page-hero wrap"><span class="eyebrow">TWO WAYS IN.</span><h1>{t(locale,'选一种，','Choose a way.')}<br/><em>{t(locale,'开始用。','Make it yours.')}</em></h1><p>{t(locale,'GUI 自带 CLI。只要终端，也可以独立安装。当前 0.3.0 内测预览从源码构建。','The GUI includes the CLI. Or install just the terminal tool. Build the current 0.3.0 preview from source.')}</p></section>
  <div class="wrap install-layout"><aside class="install-nav"><a href="#requirements">{t(locale,'构建准备','Prerequisites')}</a><a href="#gui">macOS GUI + CLI</a><a href="#cli">{t(locale,'独立 CLI','Standalone CLI')}</a><a href="#verify">{t(locale,'验证与数据保留','Verify and preserve data')}</a></aside><div class="prose install-content">
  <section id="requirements"><h2>{t(locale,'构建准备','Prerequisites')}</h2><p>{t(locale,'需要 Git、Rust 1.98.1 和平台编译工具。macOS 使用 Xcode Command Line Tools；Linux 需要 C 编译器和链接器；Windows 使用 Visual Studio C++ Build Tools 与 MSVC Rust 工具链。打包脚本还需要 Python 3，macOS GUI 构建需要完整的系统开发工具。','You need Git, Rust 1.98.1, and platform build tools. Use Xcode Command Line Tools on macOS, a C compiler and linker on Linux, and Visual Studio C++ Build Tools with the MSVC Rust toolchain on Windows. Packaging scripts also require Python 3.')}</p><Code code={'git clone https://github.com/liyown/img.git\ncd img\nrustup toolchain install 1.98.1 --profile minimal\nrustup override set 1.98.1'} lang="sh" theme="github-light"/><p>{t(locale,'安装后的应用不需要 Rust 工具链。0.3.0 尚未发布安装包；旧的 v0.2.0 下载和默认在线 CLI 安装器仍可能获取 Go 版本，不能用于获取本页预览版。','Installed applications do not need the Rust toolchain. No 0.3.0 installer is published yet. The older v0.2.0 download and default online CLI installer may still deliver Go, so they are not the preview installation path.')}</p></section>
  <section id="gui"><span class="install-label"><Icon name="desktop"/> GUI + CLI</span><h2>{t(locale,'原生 macOS 桌面版','Native macOS desktop')}</h2><p>{t(locale,'支持 macOS 13+，Apple silicon 与 Intel。以下构建当前 Mac 架构的 release 应用，内置同版本 CLI。','For macOS 13+, Apple silicon and Intel. These commands build a release app for your current Mac architecture, including the same-version CLI.')}</p><Code code={'./desktop/bundle.sh release\n# Apple silicon\nopen target/desktop/arm64/Img.app\n# Intel: open target/desktop/x86_64/Img.app'} lang="sh" theme="github-light"/><p>{t(locale,'需要 DMG / ZIP 时运行下列命令，产物位于 dist/desktop/arm64 或 x86_64。','For a DMG / ZIP, run the following. Outputs are under dist/desktop/arm64 or x86_64.')}</p><Code code={'make desktop-package'} lang="sh" theme="github-light"/><p>{t(locale,'本地包使用开发签名，尚未 Apple 公证。拖动安装 GUI 后，可在「设置 → 关于与更新 → 添加终端命令」建立 CLI 入口。','Local packages use development signing and are not Apple-notarized. After installing the GUI, add its terminal entry point through Settings → About and updates → Add terminal command.')}</p><a class="text-link" href={href(locale,'docs/desktop')}>{t(locale,'继续阅读桌面指南','Continue to the desktop guide')}<Icon name="arrow"/></a></section>
  <section id="cli"><span class="install-label"><Icon name="terminal"/> CLI ONLY</span><h2>{t(locale,'独立 Rust CLI','Standalone Rust CLI')}</h2><p>{t(locale,'macOS、Linux 与 Windows 使用同一上传核心。只构建 CLI，不引入桌面依赖。以下命令在仓库根目录执行，Windows 可在 PowerShell 中执行。','macOS, Linux, and Windows share the same upload core. Build only the CLI without desktop dependencies. Run from the repository root; Windows users can use PowerShell.')}</p><Code code={'cargo install --locked --path crates/img-cli\nimg version'} lang="sh" theme="github-light"/><p>{t(locale,'Cargo 默认安装到其 bin 目录，通常是 ~/.cargo/bin（Windows 为 %USERPROFILE%\\.cargo\\bin）。请确认目录在 PATH 中。','Cargo installs into its bin directory, usually ~/.cargo/bin (%USERPROFILE%\\.cargo\\bin on Windows). Ensure it is on PATH.')}</p><p>{t(locale,'平台目标包括 macOS arm64 / x86_64、Linux arm64 / x86_64、Windows x86_64。网站首版前的本机验收为 Apple silicon，其他平台以 GitHub CI 实际结果为准。','Targets include macOS arm64/x86_64, Linux arm64/x86_64, and Windows x86_64. Local acceptance before this site launch used Apple silicon; check actual GitHub CI results for other platforms.')}</p><a class="text-link" href={href(locale,'docs/quick-start')}>{t(locale,'配置并上传第一张图片','Configure and upload your first image')}<Icon name="arrow"/></a></section>
  <section id="verify"><h2>{t(locale,'确认版本，保留数据','Verify the version. Keep your data.')}</h2><Code code={'img version\n# img 0.3.0\n# implementation: Rust\nimg config path\nimg config validate'} lang="sh" theme="github-light"/><p>{t(locale,'升级前退出旧 GUI，再替换应用包。配置、队列和图片副本位于用户数据目录，替换应用不会主动删除它们。桌面目录沿用 ~/Library/Application Support/aperture，CLI 配置位置用 img config path 查看。','Quit the old GUI before replacing its app bundle. Configuration, queue, and image copies live in user data directories and are not removed by replacing the app. Desktop data remains at ~/Library/Application Support/aperture; use img config path for CLI configuration.')}</p><p><a href="https://github.com/liyown/img/blob/main/desktop/RELEASING.md">{t(locale,'完整打包与离线安装说明','Complete packaging and offline installation guide')}</a> · <a href="https://github.com/liyown/img/actions">{t(locale,'查看平台构建状态','View platform build status')}</a></p></section>
  </div></div>
</>}
{path==='privacy' && <>
  <section class="page-hero wrap"><span class="eyebrow">A LITTLE TRANSPARENCY.</span><h1>{t(locale,'隐私说明。','Privacy, plainly.')}</h1><p>{t(locale,'哪些内容留在本地，哪些请求会离开设备。','What stays local, and which requests leave your device.')}</p></section>
  <article class="wrap prose privacy-content"><h2>{t(locale,'本网站','This website')}</h2><p>{t(locale,'本网站由 GitHub Pages 托管。访问页面和静态资源时，GitHub 可能按其隐私政策处理 IP、请求与服务日志。网站不接收你的图片、图床凭据或命令内容。','This website is hosted by GitHub Pages. When you request pages and assets, GitHub may process IP addresses, requests, and service logs under its privacy policy. This website does not receive your images, storage credentials, or command contents.')}</p><p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub {t(locale,'隐私政策','privacy statement')}</a></p>
  <h2>{t(locale,'统计当前状态','Current analytics status')}</h2><p class="notice" data-analytics-status>{site.gaId?t(locale,'已配置 Google Analytics，但仅在你同意后加载。可在页脚「统计偏好」拒绝或撤回。','Google Analytics is configured, but loads only after you consent. Decline or withdraw through Analytics preferences in the footer.'):t(locale,'统计关闭：GA4 接入能力已准备，等待测量 ID。当前不加载 Google Analytics 脚本，不发送 GA4 统计请求，也不显示统计同意提示。','Analytics is off. GA4 integration is ready and awaiting a measurement ID. No Google Analytics scripts load, no GA4 requests are sent, and no consent banner is shown.')}</p>
  <p>{t(locale,'启用后仅在同意时统计页面访问，以及 GUI、CLI 和 GitHub 入口点击。统计不包含命令、文件路径、URL 查询参数或用户输入。Google 仍会在网络层接收请求信息。选择保存在本浏览器本地；撤回会停止后续统计并清理本网站可访问的 GA Cookie，已经发送的数据不会因此自动删除。','When configured and consented, analytics records page views and GUI, CLI, and GitHub entry clicks. It excludes commands, file paths, URL query parameters, and user input. Google still receives network request information. Your choice is saved locally in this browser. Withdrawal stops future analytics and clears accessible GA cookies; it does not automatically delete data already sent.')}</p>
  <h2>{t(locale,'img 应用','The img application')}</h2><p>{t(locale,'应用直接上传到你选择的存储服务；远程图片导入会请求源图片地址。队列、图片副本和偏好保存在本地。macOS GUI 新凭据存入系统钥匙串，原有环境变量引用保持兼容。手动或启用后的自动更新检查会请求 GitHub。','The app uploads directly to your chosen storage service; remote image imports request the source URL. Queues, image copies, and preferences stay local. New macOS GUI credentials are stored in Keychain, while existing environment references remain compatible. Manual or enabled automatic update checks contact GitHub.')}</p>
  <h2>{t(locale,'诊断与问题反馈','Diagnostics and issue reports')}</h2><p>{t(locale,'诊断由你主动导出，只包含版本、错误分类与操作阶段，不含凭据、请求正文或 URL 查询参数。是否将文件提交到公开 Issue 由你决定。公开反馈前请检查自己补充的截图和说明。','You choose when to export diagnostics. They contain version, error categories, and operation stages, excluding credentials, request bodies, and URL query parameters. You decide whether to attach them to a public issue. Review any additional screenshots and descriptions before sharing.')}</p><p class="fine-print">{t(locale,'更新于 2026-09-07','Updated September 7, 2026')}</p></article>
</>}
