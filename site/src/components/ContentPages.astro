---
import Downloads from './Downloads.astro';
import { Code } from 'astro:components';
import Icon from './Icon.astro';
import Screenshot from './Screenshot.astro';
import Actions from './Actions.astro';
import Comparison from './Comparison.astro';
import { evidence } from '../lib/comparison';
import { href, t, site, type Locale } from '../lib/site';
const { locale, path } = Astro.props as { locale: Locale; path: string };
const features = t(
  locale,
  [
    [
      'image',
      '统一图库',
      '在网格和列表之间切换。搜索文件名、存储源和链接，打开大图预览，复制需要的结果。',
      'gallery',
    ],
    [
      'layers',
      '可暂停和重试的上传队列',
      '手动导入后点击上传，可调整并发、暂停、取消或重试。传输完成后，队列会继续显示状态，直到存储服务确认结果。',
      'queue',
    ],
    [
      'sliders',
      '两个独立图片工具',
      '转换压缩、调整尺寸和裁剪。左侧预览实际结果，右侧调整参数，处理后直接保存、复制或上传。无需配置图床。',
      'tools',
    ],
  ],
  [
    [
      'image',
      'Unified library',
      'Switch between grids and lists. Search names, storage providers, and links; enlarge previews and copy results.',
      'gallery',
    ],
    [
      'layers',
      'A queue you control',
      'Manual imports wait for Upload. Concurrency, pause, cancel, retry, and server confirmation keep each image’s state clear.',
      'queue',
    ],
    [
      'sliders',
      'Two standalone image tools',
      'Convert, compress, resize, and crop. Preview the actual result and adjust parameters, then save, copy, or upload. No storage setup needed.',
      'tools',
    ],
  ],
);
const rows = t(
  locale,
  [
    [
      '桌面平台',
      'macOS / Windows / Linux',
      'macOS / Windows / Linux',
      'macOS / Windows / Linux',
      'macOS',
    ],
    ['桌面技术', 'Rust / GPUI 原生', 'Electron', 'Electron', '原生 macOS'],
    [
      'CLI',
      '独立 Rust 二进制；GUI 内置',
      'PicGo-Core（Node.js）',
      'PicList-Core（Node.js）',
      '支持命令行调用',
    ],
    [
      '存储选择',
      'R2 / S3 / OSS / GitHub / WebDAV / HTTP',
      '内置图床 + 插件生态',
      '内置图床 + 插件生态',
      '内置图床 + 自定义服务',
    ],
    ['自动复制与截图', '支持', '支持', '支持', '支持'],
    [
      '远端文件管理',
      '范围索引、检查、下载、迁移与明确确认后的删除',
      '云端相册能力',
      '远端搜索、删除与批量管理',
      '以上传与本地历史为主',
    ],
    [
      '进程内存 / 启动时间',
      '暂无可比实测',
      '暂无可比实测',
      '暂无可比实测',
      '暂无可比实测',
    ],
  ],
  [
    [
      'Desktop platforms',
      'macOS / Windows / Linux',
      'macOS / Windows / Linux',
      'macOS / Windows / Linux',
      'macOS',
    ],
    [
      'Desktop technology',
      'Rust / native GPUI',
      'Electron',
      'Electron',
      'Native macOS',
    ],
    [
      'CLI',
      'Standalone Rust binary; bundled with GUI',
      'PicGo-Core (Node.js)',
      'PicList-Core (Node.js)',
      'Command-line invocation',
    ],
    [
      'Storage',
      'R2 / S3 / OSS / GitHub / WebDAV / HTTP',
      'Built-in providers + plugins',
      'Built-in providers + plugins',
      'Built-in + custom services',
    ],
    [
      'Auto-copy and screenshots',
      'Supported',
      'Supported',
      'Supported',
      'Supported',
    ],
    [
      'Remote file management',
      'Scope indexing, checks, downloads, migration, and explicit deletion',
      'Cloud album capabilities',
      'Remote search, deletion, batch management',
      'Focus on uploading and local history',
    ],
    [
      'Process memory / startup',
      'No comparable measurement',
      'No comparable measurement',
      'No comparable measurement',
      'No comparable measurement',
    ],
  ],
);
---

{
  path === 'features' && (
    <>
      <section class="page-hero wrap">
        <>
          <span class="eyebrow">FEATURES</span>
          <h1>
            {t(locale, '从上传队列，', 'From upload queue')}
            <br />
            <em>{t(locale, '到本地图库。', 'to local library.')}</em>
          </h1>
          <p>
            {t(
              locale,
              '导入图片后检查队列，上传完成后在图库中查找。存储源和处理选项都能在设置中调整。',
              'Review imported images in the queue and find completed uploads in the library. Adjust storage and processing options in settings.',
            )}
          </p>
        </>
      </section>
      <div class="wrap feature-stories">
        {features.map(([icon, title, desc, shot], i) => (
          <section class="feature-story">
            <div>
              <span class="eyebrow">
                0{i + 1} / <Icon name={icon} />
              </span>
              <h2>{title}</h2>
              <p>{desc}</p>
              <a class="text-link" href={href(locale, 'docs/desktop')}>
                {t(locale, '查看桌面指南', 'Read the desktop guide')}
                <Icon name="arrow" />
              </a>
            </div>
            <Screenshot
              locale={locale}
              name={shot as 'gallery' | 'queue' | 'settings' | 'tools'}
            />
          </section>
        ))}
      </div>
      <>
        <section class="section wrap">
          <>
            <div class="section-intro">
              <>
                <span class="eyebrow">PERFORMANCE AND RECOVERY</span>
                <h2>
                  {t(
                    locale,
                    '大图库、失败重试与后台上传。',
                    'Large libraries, retries, and background uploads.',
                  )}
                </h2>
              </>
            </div>
            <div class="feature-grid">
              {t(
                locale,
                [
                  [
                    'bolt',
                    '按需渲染',
                    '队列、历史与图库按可见区域渲染，列表缩略图最长边 512 px，解码缓存预算 64 MiB。',
                  ],
                  [
                    'shield',
                    '队列恢复',
                    '队列在后台按顺序保存，保留最近两份有效备份。发现文件损坏时，可先恢复备份再上传。',
                  ],
                  [
                    'sliders',
                    '图片处理',
                    'PNG / JPEG 压缩、最大宽度缩放、JPEG EXIF / GPS 清理。处理的是上传副本。',
                  ],
                  [
                    'command',
                    '后台快捷操作',
                    'macOS 提供菜单栏入口；三端支持全局快捷键与批次通知，Linux 全局快捷键需要 X11。',
                  ],
                  [
                    'terminal',
                    '一个 Rust 核心',
                    '独立 CLI 与 GUI 随附 CLI 来自同一实现。无需额外安装 Node.js、Go 或 Rust 运行时。',
                  ],
                  [
                    'folder',
                    '直连存储服务',
                    '直接连接自己的 R2、S3、OSS、GitHub 或 HTTP。桌面新增凭据保存在 macOS 钥匙串。',
                  ],
                ],
                [
                  [
                    'bolt',
                    'Render what is visible',
                    'Virtual queue, history, and gallery views. List thumbnails up to 512 px, with a 64 MiB decoded-cache budget.',
                  ],
                  [
                    'shield',
                    'Queue recovery',
                    'Queue changes save in order in the background, with two recent valid backups. Recover a damaged queue before uploading.',
                  ],
                  [
                    'sliders',
                    'Image processing',
                    'PNG/JPEG optimization, maximum-width resizing, and JPEG EXIF/GPS removal. Your originals stay intact.',
                  ],
                  [
                    'command',
                    'Background quick actions',
                    'A menu bar entry on macOS, plus global shortcuts and batch notifications across platforms. Global shortcuts on Linux require X11.',
                  ],
                  [
                    'terminal',
                    'One Rust core',
                    'The standalone and bundled CLI share an implementation. No extra Node.js, Go, or Rust runtime after installation.',
                  ],
                  [
                    'folder',
                    'Upload directly to storage',
                    'Connect directly to your R2, S3, OSS, GitHub, or HTTP service. New desktop credentials are stored in macOS Keychain.',
                  ],
                ],
              ).map(([icon, title, body]) => (
                <article>
                  <span class="feature-icon">
                    <Icon name={icon} />
                  </span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </article>
              ))}
            </div>
          </>
        </section>
        <section class="closing wrap">
          <>
            <h2>
              {t(
                locale,
                '安装 GUI 或独立 CLI。',
                'Install the GUI or standalone CLI.',
              )}
            </h2>
            <Actions locale={locale} />
          </>
        </section>
      </>
    </>
  )
}
{
  path === 'compare' && (
    <>
      <section class="page-hero wrap">
        <>
          <span class="eyebrow">COMPARISON</span>
          <h1>
            {t(locale, '包体积、功能，', 'Package sizes, features,')}
            <br />
            <em>
              {t(locale, '以及各自的用途。', 'and where each tool fits.')}
            </em>
          </h1>
          <p>
            {t(
              locale,
              '对比 img、PicGo、PicList 和 uPic 的 macOS 安装包与功能，附版本、数据来源和测试条件。',
              'Compare macOS packages and features across img, PicGo, PicList, and uPic, with versions, sources, and test conditions.',
            )}
          </p>
        </>
      </section>
      <section class="wrap comparison-main">
        <>
          <Comparison locale={locale} />
          <div class="comparison-aside">
            <>
              <span class="eyebrow">STANDALONE CLI</span>
              <h2>
                7.09 <small>MB</small>
              </h2>
              <p>
                {t(
                  locale,
                  '独立 CLI 的 macOS ARM64 tar.gz 约 7.09 MB，不包含 GUI 依赖，安装后无需额外语言运行时。',
                  'The standalone CLI’s macOS ARM64 tar.gz is about 7.09 MB. It has no GUI dependencies and needs no extra language runtime.',
                )}
              </p>
              <a class="text-link" href={href(locale, 'install') + '#cli'}>
                {t(locale, '构建独立 CLI', 'Build the standalone CLI')}
                <Icon name="arrow" />
              </a>
            </>
          </div>
        </>
      </section>
      <section class="section wrap">
        <>
          <div class="section-intro">
            <>
              <span class="eyebrow">CAPABILITIES</span>
              <h2>{t(locale, '功能与使用场景', 'Features and fit')}</h2>
            </>
          </div>
          <div
            class="table-scroll"
            tabindex="0"
            role="region"
            aria-label={t(
              locale,
              '可横向滚动的功能比较表',
              'Horizontally scrollable feature comparison',
            )}
          >
            <table class="comparison-table">
              <>
                <thead>
                  <tr>
                    <th scope="col">{t(locale, '比较项', 'Capability')}</th>
                    {['img', 'PicGo', 'PicList', 'uPic'].map((n) => (
                      <th scope="col">{n}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {rows.map(([label, ...values]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      {values.map((v) => (
                        <td>{v}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          <p class="fine-print">
            {t(
              locale,
              'img 体积数据取自 0.4.0 社区版安装包（2026-09-08）；当前功能按 img 0.4。PicGo 3.0.2、PicList 3.5.0；uPic 按官方项目及 App Store 分发说明，GitHub v0.21.1 不代表最新 App Store 版。其他产品核验日期：2026-09-07。',
              'img package sizes use the 0.4.0 community release (Sep 8, 2026); current features describe img 0.4. PicGo 3.0.2, PicList 3.5.0; uPic follows its official project and App Store distribution notes. GitHub v0.21.1 is not the latest App Store version. Other products checked Sep 7, 2026.',
            )}
          </p>
        </>
        <div class="fit-grid">
          {t(
            locale,
            [
              [
                'img',
                '希望同时使用原生 GUI 和独立 CLI，看重本地队列恢复、公开源码与小包体。',
              ],
              [
                'PicGo',
                '需要跨平台桌面与成熟插件生态，想接入更多图床和已有工作流。',
              ],
              [
                'PicList',
                '需要更多云端文件管理、远程搜索、批量操作和图片处理。',
              ],
              ['uPic', '专注 macOS 上传，喜欢原生系统集成、菜单栏和快捷操作。'],
            ],
            [
              [
                'img',
                'For a native GUI plus a standalone CLI, recoverable local queues, public source, and a small package.',
              ],
              [
                'PicGo',
                'For cross-platform desktops, a mature plugin ecosystem, and many storage integrations.',
              ],
              [
                'PicList',
                'For richer remote file management, cloud search, batch operations, and image processing.',
              ],
              [
                'uPic',
                'For a macOS-focused uploader with native integration, menu-bar access, and quick actions.',
              ],
            ],
          ).map(([name, body]) => (
            <article>
              <h3>{name}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="benchmark-section">
        <div class="wrap">
          <>
            <span class="eyebrow">MEASURED ON IMG.</span>
            <h2>
              {t(locale, '一万条记录下的表现。', 'With ten thousand records.')}
            </h2>
            <div class="benchmark-values">
              <>
                <div>
                  <>
                    <strong>
                      0.039 <small>ms</small>
                    </strong>
                    <p>
                      {t(locale, '搜索计算耗时 P95', 'Search computation P95')}
                    </p>
                  </>
                </div>
                <div>
                  <>
                    <strong>
                      3.652 <small>ms</small>
                    </strong>
                    <p>
                      {t(
                        locale,
                        'GPUI CPU 绘制耗时 P95',
                        'GPUI CPU draw time P95',
                      )}
                    </p>
                  </>
                </div>
                <div>
                  <>
                    <strong>
                      64 <small>MiB</small>
                    </strong>
                    <p>
                      {t(
                        locale,
                        '缩略图缓存预算与峰值',
                        'Thumbnail cache budget and peak',
                      )}
                    </p>
                  </>
                </div>
              </>
            </div>
            <p>
              {t(
                locale,
                'Apple M4 · 16 GiB · macOS 27.0 (26A5388g) · release 构建 · 299 个绘制样本。10,000 条不同 ID 与路径的记录，使用相同的 1200 × 900 PNG 内容。',
                'Apple M4 · 16 GiB · macOS 27.0 (26A5388g) · release build · 299 draw samples. 10,000 distinct record IDs and paths using identical 1200 × 900 PNG content.',
              )}
            </p>
            <p class="fine-print">
              {t(
                locale,
                '这些是 img 自身的微基准，不是竞品测速。搜索计算不等于输入到显示的延迟；CPU 绘制不等于 GPU 完成或端到端帧率；64 MiB 不等于进程总内存。上传速度取决于图片、网络和存储服务。',
                'These are img’s own microbenchmarks, not competitor tests. Search computation is not input-to-display latency; CPU draw time is not GPU completion or end-to-end frame rate; 64 MiB is not total process memory. Upload speed depends on images, network, and storage.',
              )}
            </p>
            <a class="text-link" href={evidence.benchmark.source}>
              {t(
                locale,
                '查看测试方法与未完成验收',
                'Read the method and remaining acceptance work',
              )}
              <Icon name="external" />
            </a>
          </>
        </div>
      </section>
      <section class="section wrap prose sources">
        <>
          <h2>{t(locale, '数据来源与口径', 'Sources and methodology')}</h2>
          <p>
            {t(
              locale,
              '包体积统一使用字节数除以 1,000,000。img 来自社区版 GitHub Release，PicGo 与 PicList 来自官方 release 清单；签名方式、资源内容与功能范围可能不同，大小不能单独代表质量。uPic 缺少同版本同架构 DMG 数据，保留为空。没有可靠来源的竞品内存和启动速度不填估计数。',
              'Package sizes use bytes divided by 1,000,000. img uses its community GitHub Release; PicGo and PicList use official release manifests. Signing, resources, and feature scope differ, so size alone does not indicate quality. No comparable current uPic ARM64 DMG is available. Unsupported memory and startup estimates are left blank.',
            )}
          </p>
          <ul>
            {evidence.products.map((p) => (
              <li>
                <a href={p.source}>
                  {p.name} · {p.version} ·{' '}
                  {t(
                    locale,
                    p.kind === 'local-artifact'
                      ? '本地构建记录'
                      : p.kind === 'official-manifest'
                        ? '官方安装包清单'
                        : '官方项目说明',
                    p.kind === 'local-artifact'
                      ? 'Local build record'
                      : p.kind === 'official-manifest'
                        ? 'Official package manifest'
                        : 'Official project',
                  )}
                </a>
              </li>
            ))}
            <li>
              <a href="https://github.com/Molunerfinn/PicGo/releases/tag/v3.0.2">
                PicGo 3.0.2{' '}
                {t(locale, '功能与发行说明', 'features and release notes')}
              </a>
            </li>
            <>
              <li>
                <a href="https://piclist.cn/en/app">
                  PicList {t(locale, '官方功能说明', 'official features')}
                </a>
              </li>
              <li>
                <a href="https://picgo.github.io/PicGo-Core-Doc/guide/getting-started.html">
                  PicGo-Core CLI
                </a>
              </li>
              <li>
                <a href="https://piclist.cn/en/app#piclist-core">
                  PicList-Core CLI
                </a>
              </li>
            </>
          </ul>
        </>
      </section>
    </>
  )
}
{
  path === 'install' && (
    <>
      <section class="page-hero wrap">
        <span class="eyebrow">INSTALLATION</span>
        <h1>{t(locale, '下载即用。', 'Download. Install. Upload.')}</h1>
        <p>
          {t(
            locale,
            '选择适合你系统的社区安装包，内置完整 CLI，无需源码或开发工具。',
            'Choose the community installer for your system. The complete CLI is included; no source checkout or developer tools required.',
          )}
        </p>
      </section>
      <div class="wrap prose install-content">
        <section id="gui">
          <h2>GUI + CLI · macOS / Windows / Linux</h2>
          <p>
            {t(
              locale,
              'macOS 13+ 提供 Apple silicon 和 Intel 安装包；Windows 10/11 提供 x64 安装程序；Linux 提供 Ubuntu 24.04 / Debian 13 及更新版本的 x64 DEB。下载入口自动获取最新桌面版。',
              'macOS 13+ supports Apple silicon and Intel. Windows 10/11 uses the x64 installer; Ubuntu 24.04 / Debian 13 or newer uses the x64 DEB. Download links resolve the latest desktop release automatically.',
            )}
          </p>
          <Downloads locale={locale} />
          <p>
            {t(
              locale,
              'Windows：运行 EXE 安装向导。Linux：使用 sudo apt install ./img-desktop_*.deb 安装及升级，凭据存储需要已解锁的 Secret Service（如 GNOME Keyring）。macOS 按下方步骤安装。',
              'Windows: run the EXE installer. Linux: install or upgrade with sudo apt install ./img-desktop_*.deb; credentials require an unlocked Secret Service such as GNOME Keyring. Follow the steps below for macOS.',
            )}
          </p>
          <h3>{t(locale, '首次安装', 'First installation')}</h3>
          <ol>
            <li>
              {t(
                locale,
                '打开 DMG，将 Img.app 拖到 Applications，然后从应用程序打开。',
                'Open the DMG, drag Img.app into Applications, and launch it from there.',
              )}
            </li>
            <li>
              {t(
                locale,
                '社区版未经过 Apple 公证。若首次打开被阻止，在系统设置 → 隐私与安全性中找到 img，点击「仍要打开」。仅在确认来自本项目时继续，无需关闭系统保护。',
                'Community builds are not Apple-notarized. If the first launch is blocked, find img under System Settings → Privacy & Security and choose Open Anyway after verifying the source. Do not disable system protections.',
              )}
            </li>
            <li>
              {t(
                locale,
                '配置默认存储源，按 ⌘⌥U 直接上传剪贴板并自动复制链接。',
                'Configure a default storage provider, then press ⌘⌥U to upload your clipboard and automatically copy the link.',
              )}
            </li>
          </ol>
          <p>
            <a href="https://support.apple.com/102445">
              {t(
                locale,
                'Apple 官方首次打开说明',
                'Apple’s guide to opening downloaded apps',
              )}
            </a>
          </p>
        </section>
        <section id="verify">
          <h2>{t(locale, '后续更新', 'Future updates')}</h2>
          <p>
            {t(
              locale,
              '设置 → 关于与更新提供检查、下载校验、退出并安装更新，也可开启每天自动检查。升级保留存储配置、图库和队列；新版如被 macOS 阻止，按首次安装步骤允许打开。目录不可写时可手动替换。',
              'Settings → About and updates provides update checks, verified downloads, and installation with restart. Daily checks are optional. Storage configuration, library and queue are preserved. macOS may require allowing a new community build; use manual replacement if the app directory is not writable.',
            )}
          </p>
        </section>
        <section id="cli">
          <h2>{t(locale, '终端命令', 'Terminal command')}</h2>
          <Downloads locale={locale} product="cli" />
          <p>
            {t(
              locale,
              'GUI 已内置同版本 CLI，在「关于与更新」点击「添加终端命令」。只需要命令行时，可选择独立 CLI 发行包。',
              'The GUI bundles the matching CLI. Choose Add terminal command under About and updates, or use the standalone CLI releases.',
            )}
          </p>
          <Code
            code={'img version\nimg config path\nimg config validate'}
            lang="sh"
            theme="github-light"
          />
          <a href="https://github.com/liyown/img/releases">
            {t(
              locale,
              '独立 CLI 与全部发行版本',
              'Standalone CLI and all releases',
            )}
          </a>
        </section>
        <section id="requirements">
          <h2>
